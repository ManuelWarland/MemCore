# ── Personal data — NEVER in the repo ──────────────────────────────────────
# The database holds private memories. The code is shareable, the data is not.
# `python scripts/memcore.py init` creates an empty one.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
memcore-*.db
backups/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# ── Rebuts OS / éditeurs ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak

# ── Config locale éventuelle ───────────────────────────────────────────────
.env
.env.*
*.local
